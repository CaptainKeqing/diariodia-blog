---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				background-color: var(--paper);
			}

			/* Hero section determines the layout of the home page */
			.hero {
				display: grid;
				grid-template-columns: 1fr 2px 1fr;
				min-height: 80vh;
				border-bottom: 1px solid var(--ruler);
			}

			.eyebrow {
				font-size: 1rem;
				text-transform: : uppercase;
				color: var(--emphasis);
			}
			.hero-name emphasis {
				/* font-style: normal; */
				color: var(--emphasis);

			}

			.hero-description {
				font-size: 1rem;
				padding-left: 1rem;
				border-left: 2px solid var(--emphasis);
			}

			.hero-left {
				padding: 5rem 3rem 5rem 2rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				position: relative;
				animation: fadeUp 0.8s ease both;
			}

			.hero-divider {
				background: var(--ruler);
			}

			.hero-right {
				padding: 5rem 2rem 5rem 3rem;
				display: flex;
				flex-direction: column;  /* Stack items vertically */
				align-items: flex-end;   /* Align items to the right */
				justify-content: center; /* Center items vertically */
				animation: fadeUp 0.8s 0.15s ease both; /* Delay for staggered effect */
			}		

			.hero-quote {
				font-family: "Playfair Display", serif;
				font-size: 1.25rem;
				font-style: italic;
				text-align: right;
			}

			/* End of hero section */

			/* Defines the animation "fadeUp" */
			@keyframes fadeUp {
				from { opacity: 0; transform: translateY(20px); }
				to { opacity: 1; transform: translateY(0); }
			}

			/* Sets an alternative display if the screen width is <= 768px */
			@media (max-width: 768px) {
				.hero { grid-template-columns: 1fr; }
				.hero-divider { display: none; }
				.hero-left, .hero-right { padding: 3rem 1.5rem; }
				.hero-left::after { display: none; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">

				<!-- Left: Bio -->
				<div class="hero-left">
					<p class="eyebrow">Bienvenido</p>
					<h1 class="hero-name">Me llamo<br><emphasis>Donovan</emphasis></h1>
					<p class="hero-description">
						Soy estudiante de Informática. Me apasiona viajar, escribir, y aprender
						sobre el mundo. <br><br>
						Este blog es un espacio donde escribo sobre temas que me interesan,
						noticias que me importan, y todo lo que me llama la atención. <br><br>
						Todo en español.
					</p>
				</div>

				<div class="hero-divider"></div>

				<!-- Right: Quote -->

				<div class="hero-right">
					<p class="hero-quote">
						"Sólo el que sabe es libre y más libre el que más sabe"
					</p>
					<a class="clean-link eyebrow" href="https://www.cultura.gob.es/cultura/areas/archivos/mc/red-bibliotecas-archivos-estatales/difusion-rebae/guias-lectura/generacion-98/autores-vida-obra/miguel-de-unamuno.html" target="_blank" rel="noopener noreferrer">Miguel de Unamuno</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
